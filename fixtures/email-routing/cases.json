{
  "suite": "email-routing",
  "version": 1,
  "cases": [
    {
      "id": "reply_with_reliable_thread_metadata",
      "description": "A normal quote acceptance has both semantic and thread evidence.",
      "critical": true,
      "sessions": [
        {
          "session_id": "session-northwind-quote",
          "state": "waiting",
          "task_summary": "Prepare and close the Northwind migration quote.",
          "waits": [
            {
              "wait_id": "wait-northwind-quote-approval",
              "status": "active",
              "exclusive": true,
              "expected_event": "Northwind confirms whether Quote Q-104 is accepted.",
              "caused_by": "Sent Quote Q-104 for USD 28000.",
              "actors": ["buyer@northwind.example"],
              "entities": ["Northwind migration", "Quote Q-104", "USD 28000"],
              "phase": "quote_confirmation",
              "prior_exchange": "The buyer requested a final migration price and received Quote Q-104."
            }
          ]
        },
        {
          "session_id": "session-contoso-bug",
          "state": "waiting",
          "task_summary": "Resolve Contoso export failures.",
          "waits": [
            {
              "wait_id": "wait-contoso-log",
              "status": "active",
              "exclusive": true,
              "expected_event": "Contoso sends a failing export log.",
              "caused_by": "Asked the administrator for a fresh export log.",
              "actors": ["admin@contoso.example"],
              "entities": ["Contoso export"],
              "phase": "diagnosis",
              "prior_exchange": "The export fails near completion but no log has been provided."
            }
          ]
        }
      ],
      "event": {
        "event_id": "event-001",
        "source": "fixture-mail",
        "source_event_id": "mail-001",
        "fingerprint": "fp-001",
        "channel": "email",
        "from": "buyer@northwind.example",
        "to": ["relay@example.test"],
        "cc": [],
        "subject": "Re: Northwind migration quote",
        "body": "The USD 28000 price works for us. Please proceed.",
        "headers": {
          "provider_thread_id": "thread-northwind-quote",
          "in_reply_to": "message-q104",
          "references": ["message-q104"]
        },
        "attachments": []
      },
      "expected": {
        "disposition": "deliver",
        "target_session_ids": ["session-northwind-quote"],
        "matched_wait_ids": ["wait-northwind-quote-approval"],
        "must_not_target_session_ids": ["session-contoso-bug"],
        "delivery_mode": "start",
        "reason": "The sender, amount, project, and acceptance all match the Northwind quote wait."
      }
    },
