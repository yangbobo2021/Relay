    {
      "id": "same_thread_later_wait_phase",
      "description": "A reused thread must match the current phase instead of a consumed wait.",
      "critical": true,
      "sessions": [
        {
          "session_id": "session-tailspin-contract",
          "state": "waiting",
          "task_summary": "Close the Tailspin services agreement.",
          "waits": [
            {
              "wait_id": "wait-tailspin-price-old",
              "status": "consumed",
              "exclusive": true,
              "expected_event": "Tailspin accepts the project price.",
              "caused_by": "Sent the commercial proposal.",
              "actors": ["owner@tailspin.example"],
              "entities": ["Tailspin project", "Proposal P-77"],
              "phase": "price_approval",
              "prior_exchange": "Tailspin accepted Proposal P-77."
            },
            {
              "wait_id": "wait-tailspin-signature-current",
              "status": "active",
              "exclusive": true,
              "expected_event": "Tailspin returns the signed services agreement.",
              "caused_by": "Sent the agreement after price approval.",
              "actors": ["owner@tailspin.example"],
              "entities": ["Tailspin project", "Services Agreement SA-77"],
              "phase": "contract_signature",
              "prior_exchange": "Price is approved and SA-77 is awaiting signature."
            }
          ]
        }
      ],
      "event": {
        "event_id": "event-004",
        "source": "fixture-mail",
        "source_event_id": "mail-004",
        "fingerprint": "fp-004",
        "channel": "email",
        "from": "owner@tailspin.example",
        "to": ["relay@example.test"],
        "cc": [],
        "subject": "Re: Tailspin proposal",
        "body": "Attached is the signed agreement.",
        "headers": {
          "provider_thread_id": "thread-tailspin-commercial",
          "in_reply_to": "message-sa77",
          "references": ["message-p77", "message-sa77"]
