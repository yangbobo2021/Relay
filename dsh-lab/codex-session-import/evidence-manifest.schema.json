{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay.local/schemas/codex-session-import-evidence-manifest.json",
  "title": "Codex Session Import Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "riskId",
    "runId",
    "startedAt",
    "completedAt",
    "phase",
    "scenario",
    "result",
    "environment",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "riskId": { "type": "string", "pattern": "^CSI-[0-9]{3}$" },
    "runId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+$"
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "phase": {
      "enum": ["risk-reproduction", "solution-validation"]
    },
    "scenario": { "type": "string", "minLength": 1 },
    "result": { "enum": ["pass", "fail", "inconclusive"] },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relayCommit",
        "relayWorktree",
        "codexPluginCommit",
        "dshCommit",
        "codexCliVersion",
        "os",
        "architecture",
        "nodeVersion"
      ],
      "properties": {
        "relayCommit": { "$ref": "#/$defs/gitHash" },
        "relayWorktree": { "enum": ["clean", "dirty"] },
        "codexPluginCommit": { "$ref": "#/$defs/gitHash" },
        "codexPluginVersion": { "type": "string" },
        "dshCommit": { "$ref": "#/$defs/gitHash" },
        "dshVersion": { "type": "string" },
        "codexCliVersion": { "type": "string" },
        "appServerVersion": { "type": "string" },
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "nodeVersion": { "type": "string" },
        "npmVersion": { "type": "string" },
        "profileKind": { "enum": ["temporary", "upgrade", "user-redacted"] },
        "threadOrigin": { "enum": ["codex-cli", "codex-desktop", "dsh", "fixture", "mixed"] }
      }
    },
    "hypothesis": { "type": "string" },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": ["number", "integer", "string", "boolean", "null"] }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "not-evaluated"] },
          "observation": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "mediaType"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "mediaType": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "gitHash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
