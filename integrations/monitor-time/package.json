{
  "name": "relay-dsh-plugin-monitor-time",
  "version": "0.1.0",
  "description": "Time deadline Monitor Bundle extension for Relay on DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "./host-plugin.js",
  "exports": {
    ".": "./host-plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "README.zh.md",
    "SPEC.md",
    "docs",
    "cordis.patch.yml",
    "host-plugin.js",
    "agent-bridge.js",
    "src"
  ],
  "engines": { "node": ">=22.13" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "typecheck": "node --check host-plugin.js && node --check agent-bridge.js && node --check src/time-bundle.mjs",
    "build": "npm run typecheck",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run typecheck && npm test && npm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.1.2-0 || >=0.1.2-alpha.2 <0.1.3-0",
    "relay-dsh-plugin-events": "0.2.1",
    "relay-dsh-plugin-monitors": "0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "relay-dsh-plugin-events": { "optional": true },
    "relay-dsh-plugin-monitors": { "optional": true }
  }
}
