{
  "name": "relay-dsh-plugin-monitor-author",
  "version": "0.1.0",
  "description": "DSH Skill provider for discovering and safely creating Relay Monitor Bundles.",
  "keywords": ["dsh-plugin", "deepseek-harness", "monitoring", "monitor-bundles", "skills"],
  "license": "MIT",
  "type": "module",
  "main": "./host-plugin.js",
  "exports": {
    ".": "./host-plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "README.zh.md",
    "SPEC.md",
    "docs",
    "assets",
    "cordis.patch.yml",
    "host-plugin.js"
  ],
  "engines": { "node": ">=22.13" },
  "publishConfig": { "access": "public", "tag": "latest" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "typecheck": "node --check host-plugin.js",
    "build": "npm run typecheck",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run typecheck && npm test && npm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh-skill": ">=0.1.1-rc.2 <0.1.2-0 || >=0.1.2-alpha.2 <0.1.3-0",
    "relay-dsh-plugin-monitors": "0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-skill": { "optional": true },
    "relay-dsh-plugin-monitors": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-skill": "0.1.2-alpha.3"
  }
}
