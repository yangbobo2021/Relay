{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["actionable", "event_summary", "candidates", "evidence"],
  "properties": {
    "actionable": {
      "type": "boolean"
    },
    "event_summary": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "wait_id",
          "relevance",
          "confidence",
          "relation",
          "evidence"
        ],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "wait_id": {
            "type": "string"
          },
          "relevance": {
            "enum": ["positive", "uncertain", "negative"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "relation": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
